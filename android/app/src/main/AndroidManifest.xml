  <!-- expo-screen-capture(스크린샷 감지)가 Android 13(API 33)에서만 READ_MEDIA_IMAGES를
       자동으로 붙이는데, 앱에서 사진 선택은 시스템 포토 피커만 쓰고 이 권한은 실제로
       쓰지 않는다 — Play 정책 심사에서 "사진/동영상 권한: 시스템 선택 도구 사용" 위반으로
       반려되어(2026-08-31) 제거함. 스크린샷 감지 자체는 이 권한 없이도 동작한다. -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
  <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
  <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
  <uses-permission android:name="android.permission.VIBRATE"/>

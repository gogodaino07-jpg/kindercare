<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <!-- 헤더: 아이콘 + 킨더케어 + (여백) + 날짜 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="5dp"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="킨더케어"
            android:textColor="#1E293B"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 오늘 일정 카드 — 내용만큼만 높이를 차지하게(wrap_content) 해서, 준비물이
         적을 때 카드 아래쪽에 빈 여백이 크게 남지 않게 한다. -->
    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:background="@drawable/widget_card_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘 챙겨요"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />

        <TextView
            android:id="@+id/widget_event_1_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#1E293B"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 준비물 칩 2개를 한 줄에 나란히 두려던 중첩 LinearLayout이 렌더링 실패의
             원인 중 하나로 의심되어, 각 칩을 카드의 직계 자식으로 세로로 쌓는
             단순한 구조로 바꿈(이전에 검증된 방식과 동일). -->
        <TextView
            android:id="@+id/widget_event_1_chip_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/widget_chip_bg"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:textColor="#334155"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_event_1_chip_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_chip_bg"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:textColor="#334155"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 내일 요약 (내일 일정 없으면 전체 숨김) -->
    <LinearLayout
        android:id="@+id/widget_tomorrow_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:text="→"
            android:textColor="#16A34A"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tomorrow_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#334155"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <!-- 헤더: 아이콘 + 킨더케어 + (여백) + 날짜 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_marginEnd="6dp"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="킨더케어"
            android:textColor="#1E293B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 오늘 일정 카드 — 내용만큼만 높이를 차지하게(wrap_content) 해서, 준비물이
         적을 때 카드 아래쪽에 빈 여백이 크게 남지 않게 한다. -->
    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="vertical"
        android:background="@drawable/widget_card_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp">

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘 챙겨요"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_bg"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp" />

        <!-- 일정마다 "제목 (준비물 N개)" 한 줄씩 — 최대 3건, 넘치면 마지막 줄에
             "(+N건 더)"만 붙인다. 칩(배경 있는 wrap_content 뷰)이 실기기에서
             렌더링에 실패해서, 배경 없는 단순 텍스트 줄로 바꿈. -->
        <TextView
            android:id="@+id/widget_event_line_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#1E293B"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_event_line_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#1E293B"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_event_line_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#1E293B"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 내일 요약 (내일 일정 없으면 전체 숨김) -->
    <LinearLayout
        android:id="@+id/widget_tomorrow_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="→"
            android:textColor="#16A34A"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tomorrow_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#334155"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>

{
  "expo": {
    "name": "kindercare",
    "slug": "kindercare",
    "version": "1.3.7",
    "orientation": "portrait",
    "icon": "./assets/logo_pure_chick_transparent.png",
    "scheme": "kindercare",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#E0F2FE"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "coupang",
          "goodchoice",
          "yanolja"
        ]
      }
    },
    "android": {
      "package": "com.kindeerecare.app",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-4231795240337411~8399519719"
      },
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/logo_pure_chick_transparent.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주간 날씨를 보여드리기 위해 위치 권한이 필요해요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "아이 프로필 사진을 선택하기 위해 사진첩 접근 권한이 필요해요.",
          "cameraPermission": "아이 프로필 사진을 촬영하기 위해 카메라 권한이 필요해요."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "가정통신문·급식표를 촬영해서 AI로 분석하기 위해 카메라 권한이 필요해요.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "가족을 초대할 연락처를 선택하기 위해 연락처 접근 권한이 필요해요."
        }
      ],
      "./plugins/withoutWriteContacts",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FFFFFF"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "지문/얼굴 인식으로 앱 잠금을 해제하기 위해 필요해요."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4231795240337411~8399519719",
          "iosAppId": "ca-app-pub-4231795240337411~8399519719",
          "userTrackingUsageDescription": "맞춤형 광고를 제공하기 위해 사용됩니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "def468ac-5534-4688-8f51-21ef5ac5ad38"
      }
    },
    "owner": "dagyeongg"
  }
}

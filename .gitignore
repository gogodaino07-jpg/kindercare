# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Claude Code local settings (machine-specific)
.claude/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key

# Release signing (real upload key — never commit, unlike debug.keystore)
/release-keystore/
android/keystore.properties
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (API keys etc — never commit these)
.env
.env*.local
.env.*

# typescript
*.tsbuildinfo

# generated native folders
/ios

# IDE
.idea/
*.iml
app/.idea/

# Gemini Artifacts
.artifacts/

# Firebase configuration (Sensitive)
google-services.json

# Build files
android/build/
app/build/
build/
.cxx/
app/.cxx/

# Android machine-specific / generated (kept out even though /android is tracked now)
android/local.properties
android/.gradle/
android/.kotlin/

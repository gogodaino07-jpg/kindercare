<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <!-- 헤더: 아이콘 + 킨더케어 + (여백) + 날짜 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_marginEnd="6dp"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="킨더케어"
            android:textColor="#1E293B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 오늘 일정 카드 — 위젯을 배치한 크기만큼 고정 높이를 차지하고, 그 안의
         일정 목록(widget_event_list)이 넘치면 스크롤된다. 일정 수가 적어도
         카드 자체는 항상 이 고정 높이를 유지한다(스크롤이 가능하려면 목록
         영역이 고정 크기여야 하기 때문). -->
    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="7dp"
        android:orientation="vertical"
        android:background="@drawable/widget_card_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp">

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:text="오늘 챙겨요"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_bg"
            android:paddingHorizontal="13dp"
            android:paddingVertical="5dp" />

        <!-- 일정이 없거나 데이터를 못 불러왔을 때만 보이는 단일 안내 문구 -->
        <TextView
            android:id="@+id/widget_empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1E293B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 오늘 일정 목록 — widget_event_item.xml을 아이템으로 쓰는 진짜
             스크롤 리스트(TodayEventsRemoteViewsService/Factory가 채움).
             몇 건이든 다 넣고, 위젯 높이보다 넘치면 스크롤로 본다. -->
        <ListView
            android:id="@+id/widget_event_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- 내일 요약 (내일 일정 없으면 전체 숨김) -->
    <LinearLayout
        android:id="@+id/widget_tomorrow_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="→"
            android:textColor="#16A34A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tomorrow_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#334155"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>

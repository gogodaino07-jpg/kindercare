{
  "expo": {
    "name": "아기수학",
    "slug": "baby-math",
    "version": "0.1.0",
    "orientation": "landscape",
    "scheme": "babymath",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFF7E6"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "android": {
      "package": "com.babymath.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
